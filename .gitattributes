# Normalize text files to LF in the repo and working copy
# (overrides core.autocrlf so Windows checkouts don't flip line endings)
* text=auto eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.ttf binary
*.woff binary
*.woff2 binary
*.vsdx binary
*.docx binary
*.pdf binary
